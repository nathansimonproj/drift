# Copy this file to .env for local development. Render (or any host) should
# set these as real environment variables in its dashboard for production.

# Postgres connection string from your Neon project (or any Postgres host).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
