# Copy this file to .env for local development. Render (or any host) should
# set these as real environment variables in its dashboard for production.

# Postgres connection string from your Neon project (or any Postgres host).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# SendGrid API key, used to send password-reset emails. Get one at
# https://app.sendgrid.com/settings/api_keys. Without this set (or without
# EMAIL_FROM), reset links are logged to the server console instead of
# emailed (fine for local dev, not for prod).
SENDGRID_API_KEY=

# "From" address for outgoing email. No domain needed — verify a single
# address you own under SendGrid -> Settings -> Sender Authentication ->
# Single Sender Verification, then put that exact address here.
EMAIL_FROM=

# Public base URL of the deployed app, used to build links inside emails
# (e.g. the password reset link). Set to the real domain in production.
APP_URL=http://localhost:3000
